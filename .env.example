# TheBridge — environment template. Copy to `.env` and fill in.
# Local dev keeps photos on disk; production uses S3.

# ── Database (Neon) ─────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<password>

# ── Session signing ─────────────────────────────────────────────
JWT_SECRET=<64+ char random string>

# ── Meal photos ─────────────────────────────────────────────────
# false → stored under MEDIA_DIR on disk (default: ../uploads)
S3_ENABLED=false
S3_BUCKET=thebridge-dev-143506099438-apsouth1-media
S3_REGION=ap-south-1
# On EC2: attach an instance role — no keys needed.
# Elsewhere: set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.

# ── Deployment (docker compose) ─────────────────────────────────
# Caddy serves HTTPS for this hostname. Use your domain, or a free
# wildcard pointing at your IP: <your-ip-with-dashes>.sslip.io
DOMAIN=localhost
